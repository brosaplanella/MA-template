# Module settings: edit this file once per year (and when releasing solutions).
#
# Used by the sheets (problem sheets and assignments) for their headers, and by the
# build scripts to decide which solutions students may see. Personal settings for
# your own computer go in _local.yml (not committed; anything there overrides this
# file). Do not put release flags in _local.yml: the committed file is the record.
#
# Dates are YYYY-MM-DD, with an optional time (YYYY-MM-DD HH:MM).

module:
  code: "[[ module_code ]]"
  title: "[[ module_title ]]"
  term: "[[ term ]]"

# Lecture notes on Moodle, for {{< notes label >}} links in the HTML sheets. After the
# first upload of the notes (see README), open the notes on Moodle and paste the address
# of the page here; it looks like
#   https://moodle.example.ac.uk/pluginfile.php/123456/mod_resource/content/1/notes/index.html
# It stays valid when you upload a new version to the same File resource. Leave it empty
# for no links (the PDF never links).
notes:
  url: ""

# Icon for [1]{.difficulty} etc. in problem sheets: stars, or your own image: its path
# without extension, relative to this folder, with .pdf and .svg versions
# (e.g. a TikZ figure sheets/figs/bolt.tex gives difficulty-icon: sheets/figs/bolt)
difficulty-icon: stars
[% if n_problem_sheets > 0 %]

problem-sheets:
  defaults:
    # Lecturers who publish solutions together with the sheet can set this to
    # true here; otherwise release each sheet's solutions below.
    solutions-released: false
[% for i in range(1, n_problem_sheets + 1) %]
  problem-sheet-[[ i ]]:
    # Set to true (and add the date) when the solutions can be shown to students.
    solutions-released: false
    release-date:
[% endfor %]
[% endif %]
[% if n_assignments > 0 %]

assignments:
  defaults:
    solutions-released: false
    submission: >-
      upload your answers via Moodle as a single PDF file (typed, or a scan of
      handwritten work).
    instructions: >-
      Attempt all questions. Only some questions will be marked for credit.
    marker-instructions: >-
      Mark the questions listed in the solutions. Write general feedback for the
      whole cohort rather than individual feedback.
[% for i in range(1, n_assignments + 1) %]
  assignment-[[ i ]]:
    deadline: TBC   # YYYY-MM-DD HH:MM
    deadline-label: "UK time"
    # Set to true (and add the date) when the solutions can be shown to students.
    solutions-released: false
    release-date:
[% endfor %]
[% endif %]
